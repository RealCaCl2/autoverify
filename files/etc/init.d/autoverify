#!/bin/sh /etc/rc.common
#
# autoverify - 校园网门户自动认证服务
#
#   /etc/init.d/autoverify start|stop|restart|reload|enable|disable
#   /etc/init.d/autoverify status
#
# 配置在 /etc/config/autoverify。改配置后执行 /etc/init.d/autoverify reload
# 即可：重新把配置落到系统上 + 重启认证守护进程。
# 从 LuCI 页面保存应用时会自动触发同一条路径（procd reload trigger）。

# START / STOP / USE_PROCD 由 /etc/rc.common 读取, shellcheck 看不到这些约定
# shellcheck disable=SC2034
START=95
STOP=05
USE_PROCD=1

PROG=/usr/sbin/autoverify
APPLY=/usr/sbin/autoverify-apply

start_service() {
	config_load autoverify
	# config_get_bool 把结果写入第一个参数, shellcheck 看不到这个约定。
	# 抑制注释必须紧贴引用那一行 —— 写在赋值前只会盖住赋值行。
	config_get_bool _enabled main enabled 1
	# shellcheck disable=SC2154
	if [ "$_enabled" != "1" ]; then
		logger -t autoverify "配置中已禁用 (autoverify.main.enabled=0), 不启动"
		return 0
	fi

	[ -x "$PROG" ] || {
		logger -t autoverify "未找到 $PROG, 服务未启动"
		return 1
	}

	# 先把反检测相关配置落到系统上 (TTL 规则 / NTP / DNS 重定向)
	[ -x "$APPLY" ] && "$APPLY" >/dev/null 2>&1

	procd_open_instance
	procd_set_param command "$PROG" daemon
	# 进程异常退出时自动拉起 (3600s 内最多 5 次, 间隔 5s)
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

# /etc/config/autoverify 变化时由 reload_config 触发 reload_service，
# 因此 LuCI 页面的"保存并应用"和手改后用 uci commit 都会自动生效。
service_triggers() {
	procd_add_reload_trigger autoverify
}
